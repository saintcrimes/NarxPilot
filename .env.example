# Локальная конфигурация: npm run setup:env создаст секреты, не перезаписывая .env.
DEMO_MODE=true
DEMO_ANCHOR_DATE=2026-10-31
DEMO_SEED=31012026
APP_TIMEZONE=Asia/Tashkent
TZ=UTC
APP_ORIGIN=http://localhost:3000
POSTGRES_DB=narxpilot_demo
POSTGRES_USER=narxpilot_owner
POSTGRES_PASSWORD=
WEB_DB_PASSWORD=
WORKER_DB_PASSWORD=
DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
SESSION_SECRET=
RESERVATION_TTL_MINUTES=15
OFFER_DEFAULT_TTL_HOURS=24
OUTBOX_POLL_SECONDS=3
PRICE_TREND_THRESHOLD_PCT=2
MIN_MARKET_SELLERS=5
MIN_MARKET_ORDERS_PER_WINDOW=20
MIN_OBSERVED_DAYS_PER_WINDOW=5
MAX_SELLER_VOLUME_SHARE=0.60
ANALYTICS_MODE=descriptive
LLM_PROVIDER=disabled
CHATBOT_ENABLED=false
# local: утверждённый FAQ; bro24: только серверный вызов по bro24.md.
CHATBOT_PROVIDER=local
BRO24_API_KEY=
# Заполнить после проверки реального JSON-ответа; предполагаемого имени поля нет.
BRO24_REPLY_JSON_PATH=
BRO24_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=20
NOTIFICATION_CHANNEL=in_app
# Только для одноразовой настройки кнопки Telegram; не передаётся web/worker.
TG_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://narxpilot.software-engineer.online/

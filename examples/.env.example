# Проектируемая конфигурация. Это не готовый runtime приложения.
# Codex должен создать рабочую .env.example с проверкой обязательных значений.
APP_NAME=NarxPilot
APP_TIMEZONE=Asia/Tashkent
TZ=UTC
PORT=3000
DEMO_MODE=true
DEMO_ANCHOR_DATE=2026-10-31
DEMO_SEED=31012026

# Заполнить локально. Не хранить секреты в git.
POSTGRES_DB=narxpilot_demo
POSTGRES_USER=narxpilot_app
POSTGRES_PASSWORD=
DATABASE_URL=
WORKER_DATABASE_URL=
SESSION_SECRET=

ANALYTICS_MODE=descriptive
PRICE_TREND_THRESHOLD_PCT=2
MIN_MARKET_SELLERS=5
MIN_MARKET_ORDERS_PER_WINDOW=20
MIN_OBSERVED_DAYS_PER_WINDOW=5
MAX_SELLER_VOLUME_SHARE=0.60
FORECAST_MIN_HISTORY_DAYS=180
FORECAST_HORIZONS=1,7
FORECAST_NOMINAL_COVERAGE=0.80
OFFER_DEFAULT_TTL_HOURS=24
RESERVATION_TTL_MINUTES=15
OUTBOX_POLL_SECONDS=5

# Без ключа работают покупки и обычная аналитика; пояснения — шаблонные.
LLM_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INPUT_CHARS=16000

# Независимая справка; внешний provider требует документированного поля ответа.
CHATBOT_ENABLED=false
CHATBOT_PROVIDER=local
BRO24_API_KEY=
BRO24_REPLY_JSON_PATH=
BRO24_TIMEOUT_MS=8000

# Необязательные каналы; по умолчанию сообщения только внутри приложения.
NOTIFICATION_CHANNEL=in_app
TELEGRAM_BOT_TOKEN=

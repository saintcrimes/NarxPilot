{
  "name": "narxpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:grants": "tsx scripts/grants.ts",
    "db:seed:demo": "tsx scripts/seed.ts",
    "db:reset:demo": "tsx scripts/reset.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "pg": "8.16.3",
    "decimal.js": "10.6.0",
    "iron-session": "8.0.4",
    "zod": "3.25.76",
    "csv-parse": "6.1.0",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
